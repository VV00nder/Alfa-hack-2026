  "components": {
    "schemas": {
      "AntifraudIn": {
        "properties": {
          "inn": {
            "type": "string",
            "title": "Inn"
          },
          "amount": {
            "type": "number",
            "title": "Amount"
          },
          "channel": {
            "type": "string",
            "title": "Channel",
            "default": "web"
          }
        },
        "type": "object",
        "required": [
          "inn",
          "amount"
        ],
        "title": "AntifraudIn"
      },
      "BkiIn": {
        "properties": {
          "inn": {
            "type": "string",
            "title": "Inn"
          },
          "consent_id": {
            "type": "string",
            "title": "Consent Id"
          }
        },
        "type": "object",
        "required": [
          "inn",
          "consent_id"
        ],
        "title": "BkiIn"
      },
      "ChaosIn": {
        "properties": {
          "source": {
            "type": "string",
            "title": "Source",
            "default": "default"
          },
          "failure_rate": {
            "type": "number",
            "title": "Failure Rate",
            "default": 0.0
          }
        },
        "type": "object",
        "title": "ChaosIn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoanIn": {
        "properties": {
          "application_id": {
            "type": "string",
            "title": "Application Id"
          },
          "inn": {
            "type": "string",
            "title": "Inn"
          },
          "amount": {
            "type": "number",
            "title": "Amount"
          },
          "rate": {
            "type": "number",
            "title": "Rate"
          },
          "term_months": {
            "type": "integer",
            "title": "Term Months"
          },
          "contract_number": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Contract Number"
          }
        },
        "type": "object",
        "required": [
          "application_id",
          "inn",
          "amount",
          "rate",
          "term_months"
        ],
        "title": "LoanIn"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}