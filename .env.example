# Скопируйте в .env и при необходимости измените. Все значения имеют безопасные значения по умолчанию для локального запуска.
POSTGRES_USER=creditflow
POSTGRES_PASSWORD=creditflow
POSTGRES_DB=creditflow
# Секрет подписи JWT (в проде — из секрет-хранилища, минимум 32 байта)
JWT_SECRET=local-dev-secret-change-me-32bytes!!
# Ключевая ставка ЦБ, % (используется в ценообразовании)
KEY_RATE=14.0
# Пауза между этапами конвейера, сек (для наглядности демо; 0 — мгновенно)
PIPELINE_STEP_DELAY_SEC=1.5
# Загрузка синтетических демо-данных при первом старте
SEED_DEMO_DATA=true
# Симулятор внешних систем: задержка ответа и доля сбоев (0..1)
MOCK_LATENCY_MS=150
MOCK_FAILURE_RATE=0
# Open-weights LLM через Ollama (нужен профиль ai): docker compose --profile ai up
LLM_ENABLED=false
LLM_MODEL=qwen2.5:1.5b-instruct
# Только для публичного сервера (deploy/docker-compose.prod.yml): домен, на который указывает A-запись
DOMAIN=creditflow.example.com
